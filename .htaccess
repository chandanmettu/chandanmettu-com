ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical host: www -> apex
  RewriteCond %{HTTP_HOST} ^www\.chandanmettu\.com$ [NC]
  RewriteRule ^(.*)$ https://chandanmettu.com/$1 [R=301,L]

  # Repository housekeeping files are not part of the public site
  RewriteRule ^(README\.md|CNAME|\.nojekyll|\.gitignore)$ - [R=404,L]

  RewriteRule ^assets/account-insights-jun-aug-2026\.pdf$ - [G,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
</IfModule>
